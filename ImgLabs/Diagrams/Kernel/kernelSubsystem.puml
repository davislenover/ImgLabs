@startuml

' ComputeKernel is a protocol which requires a class implement an encode() method
' This encode method is passed a command encoder and a pipeline state which allows the implementing class to populate the buffer arguments for a kernel and setup how many threads need to be dispatched
' ComputeKernel also requires the implementing class make the kernel function name it will use known
' ComputeKernel exists to handle configuration of kernels, given each class will have it's own logic on how it wants to call kernels

' Note that allocating device memory is NOT handled by Computekernels rather, buffers will be passed to them by their corresponding factory classes (then the ComputeKernels can figure out where it goes in the function call)

interface ObservableResult <<protocol>> {
    + {abstract} addObserver<O: ResultObserver>(_ observer: O) : Void <<async>>
    + {abstract} notifyObservers() : Void <<async>>
}

interface ResultObserver<Result> <<protocol>> {
    + {abstract} update(with: Result) : Void <<async>>
}

interface ComputeKernel <<protocol>> {
    + {static} {abstract} getFunctionName() : String
    + {abstract} encode() : ((MTLComputeCommandEncoder,MTLComputePipelineState) throws -> Void)
}

note left of ComputeKernel
    Defines a class which knows how to encode a kernel shader given buffers and dispatch threads
    Has a corresponding factory class (ComputeKernelCreatable) which instanciates the class
    Is an ObservableResult which ResultObservers can subscribe to, to get the resulting value after running on device
end note

interface ComputeKernelCreatable <<protocol>> {
    + {static} {abstract} getFactoryName() : String
    + {abstract} createKernel(bufable: MTBufable, context: MetalComputeContext) : ComputeKernel <<async>> <<throws>>
}

note right of ComputeKernelCreatable
    Defines a factory class for a corresponding ComputeKernel,
    Responsible for allocating buffer memory on device based on parameters given
end note

interface MTBufable <<protocol>> {
    + {abstract} toMTLBuffer(_ device: MTLDevice) : MTLBuffer <<async>> <<throws>>
    + {abstract} MTLBufferSize() : UInt32 <<throws>>
}

class MetalComputeContext <<actor>> {
 - pipelineCache : [String:Task<MTLComputePipelineState,Error>]
 - kernelRegistry : [String:ComputeKernelCreatable]
 + getPipelineState(for computeObject: ComputeKernel) : MTLComputePipelineState <<async>> <<throws>>
 + getQueue() : MTLCommandQueue <<nonisolated>>
 + getDevice() : MTLDevice <<nonisolated>>
 + getKernel(typ : ComputeKernelCreateable, buf : MTBufable) : ComputeKernel <<async>> <<throws>>
}

class MetalRunner <<actor>> {
        + {static} runCompute(from context : MetalComputeContext, for kernels : [ComputeKernel]) : Void <<async>> <<throws>>
}

class ImageData <<Identifiable, MTBufable>> {
    - pixelData : UnsafeMutablePointer<UInt8>
    + init(_ img : CGImage) : ImageData
}

class GrayScaleConvert <<ComputeKernel, Sendable>> {
    - rgbaBuf : MTLBuffer
    - grayScaleBuf : MTLBuffer
}

class GrayScaleKernelFactory <<ComputeKernelCreatable, Sendable>> {
}

class DotProductFactory <<ComputeKernelCreatable, Sendable>> {
}

class BufferCache <<actor>> {
    - cache : [ObjectIdentifier: Task<MTLBuffer, Error>];
    + buffer(for bufable: any MTBufable, device: MTLDevice) : MTLBuffer <<async>> <<throws>>
}

note right of BufferCache {
    Used to store created MTLBuffers that are already in GPU memory which other objects may re-use
    Reduces memory usage
}

class DeviceBuffer <<MTBufable>> {
    - buffer : MTLBuffer
    + toMTLBuffer(_ device: MTLDevice) : MTLBuffer <<async>> <<throws>>
    + MTLBufferSize() : UInt32 <<throws>>
}

note bottom of DeviceBuffer {
    Wraps an MTLBuffer that already lives on the device; toMTLBuffer returns it with no copy.
    Lets a kernel's output be fed straight into the next kernel as its input, so intermediate results
    stay resident on the GPU instead of being downloaded to a [Float] and re-uploaded every stage.
    Array-producing kernels (e.g. GrayScaleConvert, Subtraction) publish a DeviceBuffer to observers
}

class BatchedDotProduct <<ComputeKernel, Sendable>> {
    - data : MTLBuffer
    - pairs : MTLBuffer
    - results : MTLBuffer
}

note bottom of BatchedDotProduct {
    Computes every pairwise dot product in a single dispatch (one threadgroup per pair, no atomics),
    replacing N*(N+1)/2 separate DotProduct kernels. Publishes one [Float] of results to observers
}

class BatchedDotProductFactory <<ComputeKernelCreatable, Sendable>> {
    + setImageArrays(_ arrays: [MTBufable]) : Void
}

ComputeKernelCreatable .l.> ComputeKernel
ComputeKernelCreatable .r.> MTBufable
ComputeKernelCreatable .u.> MetalComputeContext
ComputeKernel .u.|> ObservableResult
GrayScaleConvert .u.|> ComputeKernel
GrayScaleKernelFactory .u.|> ComputeKernelCreatable
DotProductFactory .u.|> ComputeKernelCreatable
DotProductFactory ..> BufferCache
BatchedDotProduct .u.|> ComputeKernel
BatchedDotProductFactory .u.|> ComputeKernelCreatable
DeviceBuffer .u.|> MTBufable
ImageData .u.|> MTBufable
MetalRunner .l.> MetalComputeContext
ObservableResult .l.> ResultObserver

@enduml
